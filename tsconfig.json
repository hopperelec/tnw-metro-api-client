{
  "compilerOptions": {
    "target": "es2020",
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "lib": ["es2020", "dom"],
    // The library must be browser-compatible
    "types": [],

    "strict": true,

    // tsdown does the building, so this is only for type-checking
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}